-- Measures for the da-learn-05 Marketing campaign model (table: fact_contact)
Contacts = COUNTROWS ( fact_contact )
Conversions = SUM ( fact_contact[converted] )
Conversion Rate = DIVIDE ( [Conversions], [Contacts] )
Calls = SUM ( fact_contact[campaign_calls] )
Avg Calls per Client = DIVIDE ( [Calls], [Contacts] )
Calls per Conversion = DIVIDE ( [Calls], [Conversions] )
Talk Hours (last call) = DIVIDE ( SUM ( fact_contact[duration_sec] ), 3600 )
Previously Contacted % = DIVIDE ( SUM ( fact_contact[was_previously_contacted] ), [Contacts] )
Overall Conversion Rate = CALCULATE ( [Conversion Rate], ALL ( fact_contact ) )
Lift = DIVIDE ( [Conversion Rate], [Overall Conversion Rate] )
Share of Calls = DIVIDE ( [Calls], CALCULATE ( [Calls], ALL ( fact_contact ) ) )
Share of Conversions = DIVIDE ( [Conversions], CALCULATE ( [Conversions], ALL ( fact_contact ) ) )
Mobile Conversion Rate = CALCULATE ( [Conversion Rate], dim_channel[channel_label] = "Mobile" )
Landline Conversion Rate = CALCULATE ( [Conversion Rate], dim_channel[channel_label] = "Landline" )
